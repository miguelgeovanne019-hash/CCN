
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    background: #000a75;
}

body {
    max-width: 520px;
    margin: 40px auto;
    padding: 40px 44px 44px;
    background: #fff;
    border-radius: 16px;
    font-family: "Open Sans", Arial, sans-serif;
    color: #0a0aa8;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
}

a {
    text-decoration: none;
}

h2 {
    text-align: center;
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 45px;
    background: linear-gradient(90deg, #0a3a7a, #1fb5a8, #5b1f8a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.etapas {
    display: flex;
    align-items: center;
    margin-bottom: 45px;
}

.etapas span {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #c9ccff;
    border-radius: 50%;
    font-size: 16px;
    font-weight: 600;
    color: #0a0aa8;
    background: #fff;
}

.etapas span.ativo {
    background: #0000ff;
    border-color: #0000ff;
    color: #fff;
    box-shadow: 0 0 0 5px rgba(0, 0, 255, 0.15);
}

.etapas i {
    flex: 1;
    height: 2px;
    background: #dfe2ff;
}

h1 {
    font-size: 36px;
    font-weight: 600;
    color: #000a75;
    margin-bottom: 25px;
}

p {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.6;
    margin-bottom: 20px;
}

input {
    width: 100%;
    height: 55px;
    padding: 0 16px;
    border: 1px solid #c9ccff;
    border-radius: 10px;
    font-family: inherit;
    font-size: 16px;
    color: #000a75;
    outline: none;
    transition: 0.2s;
}

input:focus {
    border-color: #0000ff;
    box-shadow: 0 0 0 3px rgba(0, 0, 255, 0.15);
}

.botoes {
    display: flex;
    gap: 16px;
    margin-top: 35px;
}

.botoes a {
    flex: 1;
}

button {
    width: 100%;
    height: 50px;
    border-radius: 10px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}

button:hover {
    transform: translateY(-2px);
    opacity: 0.92;
}

.botoes a:first-child button {
    background: #fff;
    color: #0a0aa8;
    border: 1px solid #0000ff;
}

.botoes a:last-child button {
    background: #0000ff;
    color: #fff;
    border: 1px solid #0000ff;
}

@media (max-width: 560px) {
    body {
        margin: 16px;
        padding: 32px 22px;
        min-height: auto;
    }

    h1 {
        font-size: 28px;
    }

    .etapas span {
        width: 30px;
        height: 30px;
        font-size: 12px;
    }

    .botoes {
        flex-direction: column;
    }
}
